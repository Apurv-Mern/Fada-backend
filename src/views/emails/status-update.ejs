<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= appName %> — <%= title %></title>
  </head>
  <body style="margin:0;padding:0;background:#fff;font-family:Arial,Helvetica,sans-serif;color:#333">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding:24px 12px">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px">
            <%- include('partials/email-header') %>
            <tr>
              <td style="padding:28px 24px;background:#fff9f5;border-left:1px solid #ffe8d6;border-right:1px solid #ffe8d6">
                <h1 style="margin:0 0 16px;font-size:24px;color:#222;text-align:center"><%= title %></h1>
                <p style="margin:0 0 20px;font-size:16px;color:#444;text-align:center">Hello <strong style="color:#ff7a00"><%= name %></strong>,</p>
                <% if (typeof statusLabel !== 'undefined' && statusLabel) { %>
                <p align="center" style="margin:0 0 20px">
                  <span style="display:inline-block;padding:8px 18px;border-radius:20px;font-size:14px;font-weight:700;color:#fff;background:<%= statusTone === 'rejected' ? '#d9534f' : statusTone === 'approved' ? '#28a745' : '#ff7a00' %>"><%= statusLabel %></span>
                </p>
                <% } %>
                <div style="background:#fff;border:1px solid #ffd7b3;border-radius:12px;padding:20px 24px;margin-bottom:24px">
                  <p style="margin:0;font-size:15px;line-height:1.8;color:#555;white-space:pre-wrap"><%= messageBody %></p>
                  <% if (typeof reason !== 'undefined' && reason) { %>
                  <p style="margin:16px 0 0;padding-top:16px;border-top:1px solid #ffe8d6;font-size:14px;line-height:1.6;color:#666"><strong>Reason:</strong> <%= reason %></p>
                  <% } %>
                </div>
                <% if (typeof actionUrl !== 'undefined' && actionUrl) { %>
                <p align="center" style="margin:0">
                  <a href="<%= actionUrl %>" style="display:inline-block;padding:12px 28px;background:#ff7a00;color:#fff;text-decoration:none;font-size:15px;font-weight:700;border-radius:8px"><%= actionLabel || "View Details" %></a>
                </p>
                <% } %>
              </td>
            </tr>
            <tr><td style="padding:0 24px"><div style="height:2px;background:#ff7a00"></div></td></tr>
            <tr>
              <td align="center" style="padding:22px 24px 18px">
                <p style="margin:0;font-size:16px;font-weight:700;color:#ff7a00">The <%= appName %> Team</p>
              </td>
            </tr>
            <tr>
              <td align="center" style="background:#ff7a00;padding:14px 24px;border-radius:0 0 4px 4px">
                <p style="margin:0;font-size:13px;color:#fff">&copy; <%= year %> <%= appName %>. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
