<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= appName %> Temporary Password</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
      color: #333333;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      style="background-color: #ffffff; padding: 24px 12px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="100%"
            cellspacing="0"
            cellpadding="0"
            style="max-width: 620px; background-color: #ffffff"
          >
            <tr>
              <td align="center" style="padding: 8px 24px 20px">
                <span
                  style="
                    font-size: 28px;
                    font-weight: 700;
                    color: #222222;
                    letter-spacing: 0.5px;
                  "
                >
                  FADA<span style="color: #ff7a00">-ID</span>
                </span>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 24px">
                <div
                  style="height: 2px; background-color: #ff7a00; width: 100%"
                ></div>
              </td>
            </tr>

            <tr>
              <td
                style="
                  padding: 28px 24px 24px;
                  background-color: #fff9f5;
                  border-left: 1px solid #ffe8d6;
                  border-right: 1px solid #ffe8d6;
                "
              >
                <h1
                  style="
                    margin: 0 0 16px;
                    font-size: 24px;
                    line-height: 1.3;
                    font-weight: 700;
                    color: #222222;
                    text-align: center;
                  "
                >
                  Temporary Password
                </h1>

                <p
                  style="
                    margin: 0 0 12px;
                    font-size: 16px;
                    color: #444444;
                    text-align: center;
                  "
                >
                  Hello <strong style="color: #ff7a00"><%= name %></strong>,
                </p>

                <p
                  style="
                    margin: 0 0 24px;
                    font-size: 15px;
                    line-height: 1.7;
                    color: #555555;
                    text-align: center;
                  "
                >
                  Your temporary password is provided below. Please use it to
                  log in to your account and change your password immediately
                  after logging in.
                </p>

                <div
                  style="
                    margin: 0 auto 24px;
                    max-width: 320px;
                    padding: 18px 24px;
                    text-align: center;
                    border: 1.5px solid #ffb26b;
                    border-radius: 12px;
                    background-color: #ffffff;
                    font-size: 28px;
                    font-weight: 700;
                    letter-spacing: 2px;
                    color: #ff7a00;
                  "
                >
                  <%= tempPassword %>
                </div>

                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  style="
                    background-color: #fff3ea;
                    border: 1px solid #ffd7b3;
                    border-radius: 12px;
                  "
                >
                  <tr>
                    <td style="padding: 16px 18px">
                      <p
                        style="
                          margin: 0 0 6px;
                          font-size: 15px;
                          font-weight: 700;
                          color: #ff7a00;
                        "
                      >
                        Security Note
                      </p>
                      <p
                        style="
                          margin: 0;
                          font-size: 14px;
                          line-height: 1.6;
                          color: #555555;
                        "
                      >
                        Do not share this password with anyone. After logging
                        in, go to Change Password and set a new password.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding: 0 24px">
                <div
                  style="height: 2px; background-color: #ff7a00; width: 100%"
                ></div>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 22px 24px 18px">
                <p style="margin: 0 0 6px; font-size: 15px; color: #444444">
                  Thank you,
                </p>
                <p
                  style="
                    margin: 0;
                    font-size: 16px;
                    font-weight: 700;
                    color: #ff7a00;
                  "
                >
                  The <%= appName %> Team
                </p>
              </td>
            </tr>

            <tr>
              <td
                align="center"
                style="
                  background-color: #ff7a00;
                  padding: 14px 24px;
                  border-radius: 0 0 4px 4px;
                "
              >
                <p style="margin: 0; font-size: 13px; color: #ffffff">
                  &copy; <%= year %> <%= appName %>. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
